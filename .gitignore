# Everything that starts with a dot (tool folders, IDE settings, caches), in every folder
.*
!.gitignore
# the pinned Flutter SDK version (FVM)
!.fvmrc

# Miscellaneous
*.class
*.log
*.pyc
*.swp
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
pubspec.lock
**/doc/api/
build/
coverage/

# FVM Version Cache
.fvm/